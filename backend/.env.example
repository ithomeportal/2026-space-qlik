# Backend (FastAPI on Render) — copy to .env and fill in.
# Never commit real values. Never use the Aiven master role (avnadmin) here:
# each database has its own least-privilege role since 2026-07-20; avnadmin is
# for local psql / DDL only.
#
# Percent-encode special characters in DB URLs — Render strips one "$" from
# "$$" during injection: $ -> %24, * -> %2A, @ -> %40, # -> %23, ? -> %3F

# analytics_hub — the portal's own database (users, reports, role access)
DATABASE_URL=postgresql://<role>:<password>@<host>:<port>/analytics_hub?sslmode=require

# aivn_datalake_gold — most code-made reports
SAVINGS_DATABASE_URL=
# automations_db — Track Award Loads, Performance for RFPs
AUTOMATIONS_DATABASE_URL=
# fresh_services_unlk — IT Tickets Mgmt
FRESHSERVICE_DATABASE_URL=
# unilink_portal_ap (read-only) — Carrier SMS Score, POD lookup
AP_DATABASE_URL=
# UNLK-Financial (read-only) — OPTIONAL, only prefills Bonus Calculator FX
FINANCIAL_DATABASE_URL=
# Time-off DB — daily user sync
TIMEOFF_DATABASE_URL=

ALLOWED_ORIGINS=http://localhost:3000
SEED_SECRET=

# Must be IDENTICAL to the frontend's. UNSET = the API accepts self-asserted
# identities from any caller — see SPEC-CODE-RULES §51.
PROXY_SHARED_SECRET=

# Machine bearer for external schedulers (n8n) pulling a rendered report digest
# (/api/custom/ops-portal-overview/team-digest-email). Must NOT be the same
# value as PROXY_SHARED_SECRET. Fails CLOSED: unset = that path is disabled.
REPORTS_CRON_SECRET=

# Send-only key scoped to the sending domain — never an admin-scoped key.
RESEND_API_KEY=

# External market-rate providers
SONAR_TOKEN=
LB123_CLIENT_ID=
LB123_CLIENT_SECRET=

# MS Graph (admin-ms-api app) — Mail.Send application permission + admin consent
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SEND_FROM=

# Frontend (Next.js on Vercel) — copy to .env.local and fill in.
# Never commit real values. Set secrets with
#   printf '%s' "$VALUE" | npx vercel env add NAME production
# never `echo` — a trailing newline in EMAIL_FROM once broke every login OTP.

# NextAuth v5 needs BOTH the AUTH_* and NEXTAUTH_* names.
AUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-to-random-32-chars
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-random-32-chars

# ⚠ BOTH DATABASE_URL AND RESEND_API_KEY ARE VESTIGIAL (since 2026-08-12,
# `c6d4f77`) and are kept only so the auth change can be reverted with a plain
# `git revert`. The frontend does NOT connect to Postgres and does NOT send mail
# any more: login codes are issued, mailed and verified by the FastAPI backend,
# and the provider ID is "email-code" (Credentials), NOT "resend".
# Vercel's ~23 rotating egress IPs were the sole blocker to closing Aiven's
# `ip_filter` on 27 databases, so nothing here may re-open a DB connection.
# Drop both from Vercel — together with lib/db.ts, prisma/ and @prisma/client —
# once a human has confirmed a real login works. See docs/SPEC-AUTH.md §1.
DATABASE_URL=
RESEND_API_KEY=

BACKEND_URL=http://localhost:8000

# Must be IDENTICAL to Render's — this is what proves a request came from the
# proxy and makes role_report_access real. See SPEC-CODE-RULES §51.
PROXY_SHARED_SECRET=

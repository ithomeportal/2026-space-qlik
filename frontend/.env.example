# Frontend (Next.js on Vercel) — copy to .env.local and fill in.
# Never commit real values. Set secrets with
#   printf '%s' "$VALUE" | npx vercel env add NAME production
# never `echo` — a trailing newline in EMAIL_FROM once broke every login OTP.

# NextAuth v5 needs BOTH the AUTH_* and NEXTAUTH_* names.
AUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-to-random-32-chars
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-random-32-chars

# ⚠ THERE IS NO DATABASE_URL HERE, AND ADDING ONE BACK IS A SECURITY REGRESSION.
# Removed 2026-08-31 together with lib/db.ts, prisma/, @prisma/client, prisma,
# @auth/prisma-adapter and the `postinstall: prisma generate` hook — the tail of
# the 2026-08-12 (`c6d4f77`) auth migration, once a human confirmed a real login
# works. The frontend does NOT connect to Postgres: login codes are issued,
# mailed and verified by the FastAPI backend, and the provider ID is
# "email-code" (Credentials), NOT "resend".
#
# Vercel's ~23 rotating AWS egress IPs were the SOLE blocker to closing Aiven's
# `ip_filter: 0.0.0.0/0` on an instance holding 27 databases. Re-adding a DB
# connection here re-opens that. Query through BACKEND_URL instead — always.

# ⚠ VESTIGIAL, still set on Vercel. The backend sends the login mail now, so
# nothing reads this. Safe to drop from Vercel whenever; kept only because the
# 2026-08-31 cleanup was scoped to the database half.
RESEND_API_KEY=

BACKEND_URL=http://localhost:8000

# Must be IDENTICAL to Render's — this is what proves a request came from the
# proxy and makes role_report_access real. See SPEC-CODE-RULES §51.
PROXY_SHARED_SECRET=
